        {
          "id": 1,
          "keys": [],
          "secondary_keys": [],
          "comment": "文风",
          "content": "---\nwritingstyle_request:\n  style_summary:\n    overall_impression: \"第一人称（我）叙事，主角内心独白丰富、吐槽直接、口语化；对女主的描写采用行为主义，只写行为、语言、生理反应，不写她的内心解释。\"\n    key_characteristics:\n      - \"主角内心独白丰富，纠结、吐槽、自嘲直接\"\n      - \"女主行为主义描写，通过动作、语言、生理反应展现状态\"\n      - \"口语化与描述性结合，长短句交错\"\n      - \"感官描写具体，重点是触觉和视觉\"\n      - \"性场景描写直接，不回避\"\n  dimensions:\n    point_of_view:\n      person: 第一人称（我）\n      perspective_scope: 严格限制在玩家视角内\n      focalization: 女主的内心不直接描写，只通过行为、语言、生理反应展现\n    dialogue_style:\n      naturalism_level: 高\n      character_differentiation: 女主的语言干脆、强势、有距离感；主角的内心独白吐槽、纠结\n      inclusion_of_action: 对话中频繁插入动作、表情描写\n    sensory_detail:\n      overall_frequency: 高\n      dominant_senses: 触觉（体温、柔软、湿润）、视觉（动作、表情、着装变化）\n      function_of_details: 用具体生理反应替代抽象情感\n    pacing_and_flow:\n      overall_pacing: 中偏慢，由内心活动和细节描写驱动\n      pacing_variation: 内心独白、描写时放慢，对话、动作时加快\n    structural_elements:\n      typography_emphasis: 可用破折号做语气转折\n      use_of_lists: 少用\n    specific_quirks:\n      repetitive_phrases: 主角内心可有口头禅式的吐槽\n      note: \"禁止对女主使用抽象情感标签，禁止写她的解释性内心，禁止哲学思辨\"",
